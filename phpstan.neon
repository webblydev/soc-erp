includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # reserved for data-scoped module models (CRM onward)
        -
            identifier: trait.unused
            path: app/Support/DataScope/HasDataScope.php
